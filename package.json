{
  "name": "imovies",
  "version": "1.0.0",
  "description": "IMovies - Real-Time Cinema Ticket Booking Platform (React + Express + Socket.io + MongoDB)",
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "server": "node server/src/index.js",
    "server:dev": "nodemon server/src/index.js",
    "dev": "npm --prefix client run dev",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "seed": "node server/src/seeds/seed.js",
    "standalone": "node server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
